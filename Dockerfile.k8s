# Nerve — Kubernetes image.
#
# This deliberately differs from the Dockerfile `nerve init` generates for
# Compose. That one bind-mounts the source at /nerve and runs `uv sync` plus an
# npm web build on every container start, which is right for a laptop where you
# edit the checkout live. It is wrong for Kubernetes: a pod would need the
# source on a volume, reach the network at boot, and fail to start if PyPI or
# npm were unreachable.
#
# Here the source, the Python environment, and the built web UI are all baked
# in. The result is immutable, starts without network access, and pins to a
# digest. Nothing is mounted at runtime except state.
#
# Build (from the repo root, on the `signal` branch):
#   docker build -f Dockerfile.k8s -t ghcr.io/sachiniyer/nerve:<tag> .
#
# Named Dockerfile.k8s rather than Dockerfile because upstream gitignores the
# latter — it is generated by `nerve init` and would be clobbered by the wizard.

# ---------------------------------------------------------------- web build --
FROM node:22-slim AS web

WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --quiet
COPY web/ ./
RUN npm run build


# ------------------------------------------------------------------ runtime --
FROM python:3.13-slim

# The Claude Code CLI and the Claude Agent SDK move much faster than upstream
# nerve does, and this deployment deliberately tracks them rather than
# upstream's pins. Both are build args so the image pipeline can pass the
# newest release; the defaults here are simply the last known-good pair.
#
# Neither touches uv.lock. The SDK is installed OVER the locked version after
# `uv sync` (below), so the lockfile stays byte-identical to upstream's and a
# rebase never conflicts on it. See REBASE.md.
ARG CLAUDE_CODE_VERSION=2.1.280
ARG CLAUDE_AGENT_SDK_VERSION=0.2.158

# curl: healthcheck + release downloads. git: workspace sync. gpg: apt keyrings.
# ca-certificates: TLS for everything. openssh-client: the agent pushes its own
# rebases to the fork over SSH with a repo-scoped deploy key (the nerve-update
# skill). Before this, `git fetch` over SSH in this container failed with
# "cannot run ssh" — and then `merge --ff-only` reported "Already up to date"
# against a stale ref, which is worse than failing.
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl git gpg ca-certificates openssh-client jq \
    && rm -rf /var/lib/apt/lists/*

# GitHub's SSH host keys, from GitHub's own API over HTTPS — authenticated by
# TLS, unlike an ssh-keyscan at build time, which would trust whatever answered.
RUN mkdir -p /etc/ssh \
    && curl -fsS https://api.github.com/meta \
       | jq -r '.ssh_keys[] | "github.com " + .' > /etc/ssh/ssh_known_hosts \
    && grep -q ssh-ed25519 /etc/ssh/ssh_known_hosts

# GitHub CLI — the agent uses it to open config-change PRs against the
# workspace repo (see propose_config_change).
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      | gpg --dearmor -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# gog — Google Workspace CLI. Upstream ships this; it is our Gmail path.
# Pinned to the version upstream pins.
RUN GOG_VERSION=0.11.0 \
    && ARCH=$(dpkg --print-architecture) \
    && curl -fsSL "https://github.com/steipete/gogcli/releases/download/v${GOG_VERSION}/gogcli_${GOG_VERSION}_linux_${ARCH}.tar.gz" \
      | tar xz -C /usr/local/bin gog \
    && gog --version

# himalaya — IMAP/SMTP CLI. Our Proton Mail path, via Proton Bridge on
# localhost. Release assets are named by uname-style arch, not Debian's.
RUN HIMALAYA_VERSION=2.1.0 \
    && case "$(dpkg --print-architecture)" in \
         amd64) HARCH=x86_64 ;; \
         arm64) HARCH=aarch64 ;; \
         armhf) HARCH=armv7l ;; \
         *) echo "unsupported arch: $(dpkg --print-architecture)" >&2; exit 1 ;; \
       esac \
    && curl -fsSL "https://github.com/pimalaya/himalaya/releases/download/v${HIMALAYA_VERSION}/himalaya.${HARCH}-linux.tgz" \
      -o /tmp/himalaya.tgz \
    && tar xzf /tmp/himalaya.tgz -C /tmp \
    && find /tmp -type f -name himalaya -perm -u+x -exec mv {} /usr/local/bin/himalaya \; \
    && rm -rf /tmp/himalaya.tgz /tmp/himalaya* \
    && chmod +x /usr/local/bin/himalaya \
    && himalaya --version

# Node is a runtime dependency, not just a build one: the Claude Agent SDK
# drives the Claude Code CLI, which is a Node program.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# link-cli — Stripe's agent wallet. One-time-use virtual cards; the real card
# is never exposed and every spend needs an approval tap in the Link app.
# Pinned exactly: this is the one tool here that can move money.
#
# NOTE: this was once added to a working copy and never committed, so a later
# rebuild from a clean clone silently dropped it and the wallet broke with no
# error anywhere. Use deploy.sh, which refuses to build a dirty tree quietly.
RUN npm install -g @stripe/link-cli@0.21.0 \
    && link-cli --version

# Claude Code CLI — standalone, not the copy bundled inside the SDK wheel.
# The SDK would otherwise pin the CLI to whatever its own release happened to
# ship, which is how this deployment sat on a CLI that did not know Opus 5.5
# for days after the model launched. The bundled copy is deleted further down
# so the SDK falls back to this one (it prefers bundled over PATH).
RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && claude --version

# plann — CalDAV client for the iCloud calendar shared with Sachin's iPhone.
# Chosen over khal+vdirsyncer deliberately: plann queries the server directly
# with no local cache, so the agent cannot answer "what is on today" out of a
# stale sync. icalendar is for parsing the read-only Proton .ics share link.
RUN pip install --no-cache-dir --break-system-packages 'plann==1.2.0' 'icalendar>=6.0' \
    && plann --version


# uv, pinned to the version upstream's CI uses.
COPY --from=ghcr.io/astral-sh/uv:0.12.0 /uv /usr/local/bin/uv

# The venv lives outside the source tree. Upstream does this because /nerve is
# a bind mount on Compose; we keep it because it makes the layer boundary
# obvious and matches upstream's PATH.
ENV UV_PROJECT_ENVIRONMENT=/opt/nerve-venv
ENV PATH=/opt/nerve-venv/bin:$PATH

WORKDIR /nerve

# Dependencies first, from uv.lock, so this layer survives source edits.
# --locked refuses a lockfile that has drifted from pyproject rather than
# silently re-resolving.
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-install-project --no-dev

# Then the source, then the project itself.
#
# README.md is not documentation here, it is a build input: pyproject declares
# `readme = "README.md"` and hatchling fails the wheel build without it
# ("OSError: Readme file does not exist"). It is copied at this layer rather
# than with pyproject/uv.lock above so that editing it does not invalidate the
# dependency layer.
# Startup self-check. See the module docstring: four separate bugs in one day
# produced a Running, health-checked, completely broken pod. This fails the
# rollout instead.
COPY selfcheck.py /usr/local/bin/selfcheck.py

COPY README.md ./
COPY nerve/ ./nerve/
COPY --from=web /web/dist ./web/dist
RUN uv sync --locked --no-dev

# Newer SDK than the lockfile, installed over it — see the ARG comment above.
# Then delete the CLI bundled in the wheel so the SDK resolves `claude` from
# PATH, i.e. the standalone install. selfcheck.py asserts both, because a
# future SDK that re-bundles a CLI would otherwise shadow ours silently.
RUN uv pip install --python /opt/nerve-venv/bin/python --no-cache \
      "claude-agent-sdk==${CLAUDE_AGENT_SDK_VERSION}" \
    && SDK_DIR=$(/opt/nerve-venv/bin/python -c "import claude_agent_sdk, os; print(os.path.dirname(claude_agent_sdk.__file__))") \
    && rm -f "$SDK_DIR/_bundled/claude" \
    && /opt/nerve-venv/bin/python -c "import claude_agent_sdk as s; assert s.__version__ == '${CLAUDE_AGENT_SDK_VERSION}', s.__version__; print('sdk', s.__version__)"

# Recorded for selfcheck and for whoever is debugging which build is running.
ENV NERVE_CLAUDE_CODE_VERSION=${CLAUDE_CODE_VERSION}
ENV NERVE_AGENT_SDK_VERSION=${CLAUDE_AGENT_SDK_VERSION}
LABEL org.opencontainers.image.source="https://github.com/sachiniyer/nerve" \
      dev.nerve.claude-code-version="${CLAUDE_CODE_VERSION}" \
      dev.nerve.agent-sdk-version="${CLAUDE_AGENT_SDK_VERSION}"

# Paths match upstream's Docker defaults so nothing has to be re-taught.
# Both are volume mounts in the Deployment.
ENV NERVE_DOCKER=1
ENV NERVE_HOME=/root/.nerve
ENV NERVE_WORKSPACE=/root/nerve-workspace
RUN mkdir -p /root/.nerve /root/nerve-workspace

EXPOSE 8900

# start-period is generous: first boot clones the workspace repo and runs
# migrations before the gateway binds.
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD curl -fsS http://localhost:8900/health || exit 1

# No entrypoint script. Credential resolution in upstream's entrypoint exists
# to pull secrets out of config.local.yaml on macOS, where Docker cannot read
# the Keychain. Here every secret arrives as an environment variable from
# External Secrets, which is what the SDK and the CLIs already read.
#
# `init --if-needed` is a no-op once the install is no longer fresh, so this is
# safe on every restart; it only does work on the first boot of a new PVC
# (migrations, system.yaml). `exec` so nerve is PID 1 and gets SIGTERM.
CMD ["sh", "-c", "nerve -c \"$NERVE_HOME\" init --if-needed --non-interactive && python3 /usr/local/bin/selfcheck.py && exec nerve -c \"$NERVE_HOME\" start -f"]
